# Python / packaging
.venv/
__pycache__/
*.pyc
build/
dist/
*.egg-info/

# Local runtime lab selection (private, machine-specific).
lab/settings.yaml

# Real topology data is private lab information by default.
# Only the fictional sample topology is tracked.
lab/topologies/*.yaml
!lab/topologies/sample.yaml

# access-info holds private device connection data (address/username/
# password) and is never exposed by MCP. Only the fictional sample is
# tracked; every other access-info file (including any real lab data a
# user creates locally, e.g. via the CLI) stays untracked and ignored.
lab/access-info/*.yaml
!lab/access-info/sample.yaml

# Scenario/reference content can describe private task or customer
# context. Only the fictional samples are tracked.
lab/scenarios/*.yaml
!lab/scenarios/sample.yaml
lab/references/*.yaml
!lab/references/sample.yaml

# Persistent terminal session transcripts (logs/terminal/<device-id>/*.log)
# are runtime artifacts, potentially containing full device output --
# never committed.
logs/

# Local-only development history: detailed engineering notes that are not
# meant for the public repository.
docs/development_history.md
